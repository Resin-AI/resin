{
  "name": "resin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.24.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "build": "turbo run compile",
    "compile": "tsc -b && node scripts/write-cli-bundled-release-trust.mjs",
    "build:derivation-stdlib": "node scripts/build-derivation-stdlib.mjs",
    "test": "vitest run --exclude scripts/verify-release.test.mjs --exclude scripts/standalone-release-artifact.test.mjs --exclude apps/cli/tests/installer-e2e.test.ts --exclude apps/cli/tests/installer/npm-pack-offline-install.test.ts --exclude apps/cli/tests/installer/packaged-cli-production-http.test.ts --exclude packages/runtime/tests/workflow/derivation-steps.test.ts --exclude packages/runtime/tests/workflow/derivation-sandbox-imports.test.ts --exclude packages/runtime/tests/workflow/derivation-sandbox-host.test.ts --exclude packages/runtime/tests/workflow/derivation-sandbox-bounds.test.ts --exclude apps/gateway/tests/proxy/derivation-binding-replay.test.ts --exclude scripts/release-packaging-hygiene.test.mjs --exclude scripts/pack-public-packages.test.mjs",
    "test:sandbox": "vitest run packages/runtime/tests/workflow/derivation-steps.test.ts packages/runtime/tests/workflow/derivation-sandbox-imports.test.ts packages/runtime/tests/workflow/derivation-sandbox-host.test.ts packages/runtime/tests/workflow/derivation-sandbox-bounds.test.ts apps/gateway/tests/proxy/derivation-binding-replay.test.ts",
    "test:e2e": "vitest run --config vitest.packaged.config.ts --no-file-parallelism apps/cli/tests/installer-e2e.test.ts apps/cli/tests/installer/npm-pack-offline-install.test.ts apps/cli/tests/installer/packaged-cli-production-http.test.ts",
    "test:watch": "vitest",
    "lint": "biome check . && oxlint .",
    "lint:fix": "biome check --write . && oxlint --fix .",
    "format": "biome format --write .",
    "typecheck": "turbo run compile",
    "check": "pnpm run check:adrs && pnpm run check:boundaries && pnpm run check:secrets && pnpm run lint && pnpm run typecheck && pnpm run build && pnpm run test && pnpm run test:sandbox && node scripts/build-install-helper.mjs --check",
    "check:all": "pnpm run check && pnpm run release:test && pnpm run test:e2e",
    "check:adrs": "node scripts/verify-adrs.mjs",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check:repo-boundary": "node scripts/check-boundaries.mjs",
    "check:privacy-boundary": "vitest run apps/observer/tests/sync/privacy-boundary.test.ts",
    "check:hostile-cloud": "vitest run packages/runtime/tests/security.test.ts apps/observer/tests/sync/preactivation.test.ts apps/observer/tests/sync/signed-activation-and-quarantine.test.ts",
    "check:runtime-security": "vitest run packages/runtime/tests/brokers/fs-security.test.ts packages/runtime/tests/brokers/net-security.test.ts packages/runtime/tests/brokers/cmd-security.test.ts apps/observer/tests/ipc.test.ts apps/cli/tests/installer/asset-downloader-security.test.ts",
    "check:secrets": "node scripts/check-secrets.mjs",
    "check:smoke": "node scripts/verify-binaries.mjs",
    "check:public-artifact": "vitest run --no-file-parallelism --testTimeout=90000 --hookTimeout=30000 scripts/standalone-release-artifact.test.mjs",
    "release:package": "node scripts/package-release.mjs",
    "release:packages": "node scripts/pack-public-packages.mjs",
    "release:evidence": "node scripts/generate-release-evidence.mjs",
    "release:publish": "node scripts/publish-public-release.mjs",
    "release:verify": "node scripts/verify-release-cli.mjs",
    "savings:proof": "node scripts/generate-savings-proof.mjs",
    "release:test": "pnpm run release:test:verify && pnpm run release:test:packaging && pnpm run check:public-artifact",
    "release:test:verify": "vitest run --no-file-parallelism --testTimeout=90000 --hookTimeout=120000 scripts/verify-release.test.mjs",
    "release:test:packaging": "vitest run --no-file-parallelism --testTimeout=90000 --hookTimeout=120000 scripts/release-packaging-hygiene.test.mjs scripts/pack-public-packages.test.mjs && pnpm run check:smoke",
    "clean": "turbo run clean"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@oxlint/plugins": "1.86.0",
    "@types/node": "^22.20.4",
    "bun": "1.4.2",
    "esbuild": "0.28.2",
    "oxlint": "1.86.0",
    "turbo": "^2.11.6",
    "typescript": "^5.7.3",
    "vitest": "^4.1.11",
    "yaml": "2.9.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["@biomejs/biome", "bun", "esbuild"],
    "overrides": {
      "sharp": ">=0.35.5",
      "yaml": "2.9.1"
    }
  }
}
