{
  "name": "@resin/observer",
  "version": "0.1.0",
  "description": "Observer application for monitoring and auditing.",
  "private": false,
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Resin-AI/resin.git",
    "directory": "apps/observer"
  },
  "homepage": "https://github.com/Resin-AI/resin#readme",
  "bugs": {
    "url": "https://github.com/Resin-AI/resin/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "files": ["dist", "README.md", "LICENSE", "NOTICE"],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./recording": {
      "types": "./dist/recording.d.ts",
      "import": "./dist/recording.js",
      "default": "./dist/recording.js"
    },
    "./client": {
      "types": "./dist/client-api.d.ts",
      "import": "./dist/client-api.js",
      "default": "./dist/client-api.js"
    },
    "./daemon": {
      "types": "./dist/bin/daemon.d.ts",
      "import": "./dist/bin/daemon.js",
      "default": "./dist/bin/daemon.js"
    },
    "./error-reporting": {
      "types": "./dist/error-reporting/index.d.ts",
      "import": "./dist/error-reporting/index.js",
      "default": "./dist/error-reporting/index.js"
    },
    "./error-reporting/core": {
      "types": "./dist/error-reporting/core.d.ts",
      "import": "./dist/error-reporting/core.js",
      "default": "./dist/error-reporting/core.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@lezer/python": "1.1.19",
    "@resin/adapter-claude-code": "workspace:*",
    "@resin/adapter-codex": "workspace:*",
    "@resin/adapter-grok-build": "workspace:*",
    "@resin/adapter-cursor-cli": "workspace:*",
    "@resin/adapter-muse-code": "workspace:*",
    "@resin/adapter-copilot-cli": "workspace:*",
    "@resin/adapter-omp": "workspace:*",
    "@resin/adapter-opencode": "workspace:*",
    "@resin/adapter-pi": "workspace:*",
    "@resin/contracts": "workspace:*",
    "@resin/crypto": "workspace:*",
    "@resin/db": "workspace:*",
    "@resin/harness-contracts": "workspace:*",
    "@resin/protocol": "workspace:*",
    "@resin/windows-security": "workspace:*",
    "posthog-node": "^5.54.1",
    "typescript": "5.9.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@resin/test-fixtures": "workspace:*"
  }
}
