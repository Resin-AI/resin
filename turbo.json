{
  "$schema": "https://turbo.build/schema.json",
  "agentGuidance": false,
  "globalDependencies": ["tsconfig.base.json"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "lint": {
      "outputs": []
    },
    "test": {
      "dependsOn": ["build"],
      "outputs": []
    },
    "check": {
      "dependsOn": ["typecheck", "lint", "test"],
      "outputs": []
    },
    "clean": {
      "cache": false
    },
    "//#build:derivation-stdlib": {
      "inputs": [
        "scripts/build-derivation-stdlib.mjs",
        "packages/runtime/src/workflow/derivation-assets.json",
        "packages/runtime/package.json",
        "pnpm-lock.yaml"
      ],
      "outputs": ["packages/runtime/dist/workflow/python_stdlib.zip"]
    },
    "//#compile": {
      "dependsOn": ["//#build:derivation-stdlib"],
      "inputs": [
        "tsconfig.json",
        "tsconfig.base.json",
        "pnpm-lock.yaml",
        "pnpm-workspace.yaml",
        "scripts/write-cli-bundled-release-trust.mjs",
        "apps/*/src/**",
        "apps/*/tsconfig*.json",
        "apps/*/package.json",
        "packages/*/src/**",
        "packages/*/tsconfig*.json",
        "packages/*/package.json",
        "adapters/*/src/**",
        "adapters/*/tsconfig*.json",
        "adapters/*/package.json",
        "fixtures/*/src/**",
        "fixtures/*/tsconfig*.json",
        "fixtures/*/package.json"
      ],
      "outputs": [
        "apps/*/dist/**",
        "packages/*/dist/**",
        "!packages/runtime/dist/workflow/python_stdlib.zip",
        "adapters/*/dist/**",
        "fixtures/*/dist/**",
        "apps/cli/.tsbuildinfo"
      ]
    }
  }
}
