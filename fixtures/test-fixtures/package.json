{
  "name": "@resin/test-fixtures",
  "version": "0.1.0",
  "description": "Shared test fixtures, conformance runner, schema diffing, and mock datasets for Resin.",
  "private": false,
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Resin-AI/resin.git",
    "directory": "fixtures/test-fixtures"
  },
  "homepage": "https://github.com/Resin-AI/resin#readme",
  "bugs": {
    "url": "https://github.com/Resin-AI/resin/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "files": ["dist", "bin", "README.md", "LICENSE", "NOTICE"],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "resin-conformance": "./bin/conformance.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./golden": {
      "types": "./dist/golden/index.d.ts",
      "import": "./dist/golden/index.js",
      "default": "./dist/golden/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@resin/contracts": "workspace:*",
    "@resin/harness-contracts": "workspace:*",
    "@resin/protocol": "workspace:*",
    "zod": "^3.25.76"
  }
}
